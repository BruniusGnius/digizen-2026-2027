{
  "name": "digizen-landing-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/preview.mjs && vite --config vite.preview.config.js --host 127.0.0.1",
    "dev:laravel": "vite",
    "build": "node scripts/preview.mjs && vite build && vite build --config vite.preview.config.js && node scripts/package.mjs",
    "preview": "vite preview --config vite.preview.config.js --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "laravel-vite-plugin": "^2.0.0",
    "@playwright/test": "^1.55.0",
    "linkedom": "^0.18.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0"
  }
}
